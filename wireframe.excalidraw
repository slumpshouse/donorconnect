      "versionNonce": 10599,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774624284918,
      "link": null,
      "locked": false,
      "text": "CSS was challenging — after making the public pages I realized the design looked bland. Making them match the rest of the app took iteration.",
      "fontSize": 8,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CSS was challenging — after making the public pages I realized the design looked bland. Making them match the rest of the app took iteration.",
      "lineHeight": 1.25,
      "baseline": 8
