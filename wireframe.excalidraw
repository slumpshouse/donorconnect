      "seed": 10592,
      "version": 1,
      "versionNonce": 10593,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774624284918,
      "link": null,
      "locked": false,
      "text": "Creating the rubric evidence and reflection pages went well. The CSS looked fine and it wasn't hard to decide what content to include.",
      "fontSize": 8,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Creating the rubric evidence and reflection pages went well. The CSS looked fine and it wasn't hard to decide what content to include.",
      "lineHeight": 1.25,
      "baseline": 8
    },
