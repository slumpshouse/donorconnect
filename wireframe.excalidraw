      "text": "What went well",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What went well",
      "lineHeight": 1.25,
      "baseline": 10
    },
    {
      "id": "g9796",
      "type": "text",
      "x": 514,
      "y": 7858,
      "width": 248,
      "height": 62,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
