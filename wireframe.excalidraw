      "text": "What was challenging",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What was challenging",
      "lineHeight": 1.25,
      "baseline": 10
    },
    {
      "id": "g9799",
      "type": "text",
